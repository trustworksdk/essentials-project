<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dk.trustworks.essentials</groupId>
        <artifactId>parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <description>
        Generated Java client for the Essentials Admin API, produced from
        components/admin-api-spec/openapi/essentials-admin-api.yaml via openapi-generator
        (java + native/java.net.http library). Sources are generated at build time; the contract is
        the single source of truth.
    </description>

    <groupId>dk.trustworks.essentials.components</groupId>
    <artifactId>admin-api-client-java</artifactId>
    <name>admin-api-client-java</name>
    <packaging>jar</packaging>

    <properties>
        <!-- This version *is* the client's public API: every class under ${generated.client.package} is
             emitted by the plugin, so a bump changes the surface consumers compile against while no source
             in this module moves. A green build proves nothing here — nothing in this repo calls the client.
             Diff the generated surface itself (javap over target/classes, before vs after) and treat
             removals or signature changes as the API break they are. The 7.8.0 -> 7.24.0 move, for
             instance, retyped the async response interceptor from HttpResponse<String> to
             HttpResponse<InputStream> and made updateBaseUri final. -->
        <openapi-generator.version>7.24.0</openapi-generator.version>
        <jakarta-annotation.version>2.1.1</jakarta-annotation.version>
        <!-- The contract this client is generated from -->
        <admin-api.spec>${project.basedir}/../admin-api-spec/openapi/essentials-admin-api.yaml</admin-api.spec>
        <generated.client.package>dk.trustworks.essentials.components.adminapi.client</generated.client.package>
    </properties>

    <dependencies>
        <!-- Runtime dependencies the generated 'native' (java.net.http) Jackson client needs to compile -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jdk8</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>${jakarta-annotation.version}</version>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <configuration>
                        <archive>
                            <manifestEntries>
                                <Automatic-Module-Name>dk.trustworks.essentials.components.adminapi.client.java</Automatic-Module-Name>
                            </manifestEntries>
                        </archive>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>
                    <execution>
                        <id>generate-java-client</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${admin-api.spec}</inputSpec>
                            <generatorName>java</generatorName>
                            <library>native</library>
                            <invokerPackage>${generated.client.package}</invokerPackage>
                            <apiPackage>${generated.client.package}.api</apiPackage>
                            <modelPackage>${generated.client.package}.model</modelPackage>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <configOptions>
                                <library>native</library>
                                <useJakartaEe>true</useJakartaEe>
                                <openApiNullable>false</openApiNullable>
                                <serializationLibrary>jackson</serializationLibrary>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                                <sourceFolder>src/main/java</sourceFolder>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
