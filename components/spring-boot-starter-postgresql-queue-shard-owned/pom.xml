<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dk.trustworks.essentials</groupId>
        <artifactId>parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>dk.trustworks.essentials.components</groupId>
    <artifactId>spring-boot-starter-postgresql-queue-shard-owned</artifactId>
    <name>spring-boot-starter-postgresql-queue-shard-owned</name>
    <packaging>jar</packaging>
    <description>
        Spring Boot auto-configuration for the shard-owned PostgreSQL queue engine. Experimental and
        NOT published, for the same reason the engine is not: its SPI is still moving.
    </description>

    <properties>
        <!-- Follows the engine it configures: the engine is unpublished, so a starter for it must be. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dk.trustworks.essentials.components</groupId>
            <artifactId>postgresql-queue-shard-owned</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            The DurableQueues adapter, selected by essentials.shard-owned-queue.durable-queues-enabled.

            A hard dependency rather than optional, deliberately. Optional plus @ConditionalOnClass
            would make the flag a silent no-op for anyone who set it without also adding the jar: the
            context would start, back DurableQueues with the default engine, and report nothing. Both
            modules are unpublished and experimental, so there is no release cost to carrying it.
        -->
        <dependency>
            <groupId>dk.trustworks.essentials.components</groupId>
            <artifactId>postgresql-queue-shard-owned-adapter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <version>${spring-boot.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
            <version>${spring-boot.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <version>${spring-boot.version}</version>
            <optional>true</optional>
        </dependency>
        <!--
          provided, per the project-wide rule: the engine declares the driver the same way, and a
          consumer brings the one it actually uses.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
          provided: this brings the event-store starter with it, and an application that wants a queue
          and nothing else must not acquire an event store by depending on this starter. The admin
          endpoints are wired only when these classes are already present, which is exactly the case
          where the application has chosen the admin API itself.
        -->
        <dependency>
            <groupId>dk.trustworks.essentials.components</groupId>
            <artifactId>spring-boot-starter-admin-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!--
          Both declared directly because the admin API starter also declares them provided, and a
          provided dependency's provided transitives are omitted rather than inherited.

          Jackson 3 specifically, not the flavor property: Spring Boot's web message conversion is
          always Jackson 3, so the HTTP layer's correctness must not depend on the flavor chosen for
          the event store's serialization. Same reasoning as AdminApiJacksonModule's.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <version>${spring-boot.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
