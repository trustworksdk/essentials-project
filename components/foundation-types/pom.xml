<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>


    <parent>
        <groupId>dk.trustworks.essentials</groupId>
        <artifactId>parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <description>
        This library provides foundational types used by the essential components.
    </description>

    <groupId>dk.trustworks.essentials.components</groupId>
    <artifactId>foundation-types</artifactId>
    <name>foundation-types</name>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>dk.trustworks.essentials</groupId>
            <artifactId>types</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.uuid</groupId>
            <artifactId>java-uuid-generator</artifactId>
            <version>${java-uuid-generator.version}</version>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <configuration>
                        <archive>
                            <manifestEntries>
                                <Automatic-Module-Name>dk.trustworks.essentials.components.foundation.types</Automatic-Module-Name>
                            </manifestEntries>
                        </archive>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-module-dependency-direction</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <!--
                                      Artifact-level guard for the core dependency chain:
                                      shared -> types/reactive -> foundation-types -> foundation
                                      -> postgresql-event-store -> eventsourced-aggregates.
                                      foundation-types may depend only on types/ (and shared/
                                      transitively). This is where the postgresql-event-store
                                      boundary is enforced: EssentialsArchitectureTest cannot
                                      express it because foundation-types declares the event-store
                                      type primitives under the shared ...eventstore.postgresql...
                                      package namespace, so a POM-level ban is the precise gate.
                                    -->
                                    <excludes>
                                        <exclude>dk.trustworks.essentials*:*</exclude>
                                    </excludes>
                                    <includes>
                                        <include>dk.trustworks.essentials:shared</include>
                                        <include>dk.trustworks.essentials:types</include>
                                    </includes>
                                    <message>foundation-types may depend only on types/ (and shared/ transitively) - never on foundation, postgresql-event-store, or any downstream module.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>