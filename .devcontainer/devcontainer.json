{
    "name": "essentials-project",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".",
        "args": {
            // Project identity — used for container naming and Docker labels
            "PROJECT_NAME": "essentials-project",

            // Installation toggles (true/false)
            "INSTALL_JAVA": "true",
            // Kotlin LSP (official JetBrains Kotlin/kotlin-lsp). Runs on the
            // JVM, so requires INSTALL_JAVA=true. The bundled IntelliJ-platform
            // server adds ~800 MB to the image
            "INSTALL_KOTLIN_LSP": "true",
            "INSTALL_CLAUDE": "true",
            // Local-first agent stack (graphify + headroom). graphify is
            // the knowledge-graph indexer (code + SQL + infra + docs; tree-sitter,
            // fully local, no model calls). headroom transparently compresses what
            // Claude Code reads. All MIT/Apache. graphify + headroom install in
            // post-create.sh (uv tools).
            "INSTALL_GRAPHIFY": "true",
            "INSTALL_HEADROOM": "true",
            // rtk (Rust Token Killer) — transparent CLI-output compression,
            // activated with the local-first stack. Build-time binary + a Claude
            // Code PreToolUse hook installed in post-create.sh.
            "INSTALL_RTK": "true",

            // JetBrains Gateway support
            "INSTALL_JETBRAINS": "true",

            // Git identity is in containerEnv (not here) to avoid leaking PII into image layers.

            // Version configuration
            // MAVEN_SHA512 is managed in Dockerfile — only override here if you
            // change MAVEN_VERSION to a version different from the Dockerfile default.
            // JAVA_VERSION is the default JDK: it backs /usr/lib/jvm/temurin-jdk and
            // JAVA_HOME. 25 is required by the Spring Boot 4 branches, which compile with
            // maven.compiler.release=21 but enforce requireJavaVersion [21,26).
            "JAVA_VERSION": "25",
            // Kept installed alongside the default for the Java 17 branches. Build those
            // with JAVA_HOME=/usr/lib/jvm/temurin-17-jdk-$(dpkg --print-architecture).
            "ADDITIONAL_JAVA_VERSIONS": "17",
            "MAVEN_VERSION": "3.9.16",

            // JetBrains IDE backend — for reference/scripts only.
            // To change the actual IDE, edit customizations.jetbrains.backend below.
            "JETBRAINS_BACKEND": "IntelliJ"
        }
    },
    "workspaceFolder": "/workspace",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",

    // ==========================================================================
    // DevContainer Features
    // ==========================================================================
    "features": {
        // Docker-in-Docker support for TestContainers and container workflows.
        // Required for `mvn verify` (integration tests use Testcontainers).
        // moby: false → installs Docker CE from download.docker.com instead of Microsoft's
        // Moby packages. Required on Debian trixie+ (Moby packages removed from trixie).
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "version": "latest",
            "moby": false,
            "dockerDashComposeVersion": "v2"
        },
        // Node.js via DevContainer feature.
        "ghcr.io/devcontainers/features/node:1": {
            "version": "25",
            "nodeGypDependencies": true
        },
        // Python via DevContainer feature
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.14",
            "installTools": true
        }
    },

    // ==========================================================================
    // User Configuration
    // ==========================================================================
    "remoteUser": "vscode",

    // ==========================================================================
    // Environment Variables
    // ==========================================================================
    "containerEnv": {
        "LANG": "en_US.UTF-8",
        "LANGUAGE": "en_US:en",
        "LC_ALL": "en_US.UTF-8",
        // JetBrains remote development
        "JETBRAINS_REMOTE_DEV_NON_INTERACTIVE": "1",
        // Timezone (override to match your deployment region)
        "TZ": "UTC",
        // Java runtime options for containers (overridable here without rebuild)
        "JAVA_TOOL_OPTIONS": "-XX:+UseContainerSupport -XX:InitialRAMPercentage=10 -XX:MaxRAMPercentage=40 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/tmp",
        // Pinned here as well as in /etc/profile.d/java.sh, which only runs for login
        // shells. Non-login shells (anything an IDE or agent spawns) would otherwise
        // inherit whatever JAVA_HOME the launching process happened to export — the
        // JetBrains terminal supplies a stale /usr/lib/jvm/msopenjdk-current, which does
        // not exist in this image and makes mvn refuse to start.
        "JAVA_HOME": "/usr/lib/jvm/temurin-jdk",
        // Telemetry opt-out. CodeGraph is telemetry default-on and posts events to
        // telemetry.getcodegraph.com (→ PostHog, US). Per its docs it shares only
        // anonymous aggregates — random local machine_id, version, OS/arch, Node
        // major, CI flag, plus install/index/daily-usage/uninstall events (language
        // names, coarse file-count & duration buckets, per-tool call counts) — and
        // explicitly NOT source code, file/dir/repo names or paths, symbol names,
        // search queries, IPs, hostnames, usernames, emails, or env vars. Restrained,
        // but default-on to a managed backend, so we disable it in the
        // container. NOTE: this container has no INSTALL_CODEGRAPH toggle and does
        // not install CodeGraph — these are pinned pre-emptively so the opt-out is
        // already in force the day it is added (and if anyone installs it by hand),
        // and they cost nothing while it is absent. They apply to every process in
        // the container, including a `codegraph serve --mcp` server Claude Code
        // might spawn. CODEGRAPH_TELEMETRY=0 is CodeGraph-specific; DO_NOT_TRACK=1
        // is the cross-tool opt-out standard (https://consoledonottrack.com).
        // If CodeGraph is ever added to post-create.sh, also run
        // `codegraph telemetry off` there as a third, persisted opt-out
        // ("off means off" — no events recorded, no connection opened, no opt-out ping).
        "CODEGRAPH_TELEMETRY": "0",
        "DO_NOT_TRACK": "1",
        // CodeGraph also background-checks GitHub for a newer release from the
        // long-lived `codegraph serve --mcp` process (>= 1.5.0). DO_NOT_TRACK=1
        // already suppresses it; this is the dedicated switch, pinned explicitly so
        // the opt-out does not rest on one incidental var.
        // NOTE (not an env var): `codegraph install` / `codegraph upgrade` offer a
        // one-time Pro beta-waitlist prompt that POSTs an email to
        // getcodegraph.com/api/waitlist. Strictly opt-in and TTY-gated, so a
        // non-interactive install can never trigger it — but do not answer it if
        // you run those commands by hand.
        "CODEGRAPH_NO_UPDATE_CHECK": "1",

        // Local-first stack: keep everything offline. graphify ships no telemetry
        // (we also disable its local query log — opt-in upstream since #1797, but
        // pinned off here). headroom is the one that needs additional configuration: since 0.35.0 it
        // has TWO independent telemetry switches, and they default OPPOSITELY.
        //   HEADROOM_TELEMETRY — local aggregation only, off by default, fail-CLOSED.
        //                        Never leaves the machine; we do not set it. Note: may change in the future
        //   HEADROOM_BEACON    — uploads anonymous session summaries to Headroom Labs
        //                        (headroom-beacon.workers.dev). ON by default and
        //                        fail-OPEN (an unrecognised value uploads), and it
        //                        fires on the MCP path we use: ccr/mcp_server.py
        //                        beacons after every headroom_compress, per subagent.
        // DO_NOT_TRACK=1 above does disable the beacon, but resting a default-on
        // uploader on one incidental var is not a posture. HEADROOM_OFFLINE=1 is the
        // upstream fail-closed master switch right now (beacon + update check + the managed
        // licence/usage reporter + HuggingFace downloads, all off together); the
        // per-feature vars are kept alongside it so the intent survives a refactor.
        // Note for this install: the offline flag only forces HF/Transformers offline
        // (we install `[code,mcp]` — no ML extras), and headroom_stats reads its own
        // counters + the savings ledger, not the telemetry collector.
        // CCR originals + state live on the ~/.headroom named volume
        // (HEADROOM_WORKSPACE_DIR). Harmless when the tools are not installed.
        "HEADROOM_BEACON": "off",
        "HEADROOM_OFFLINE": "1",
        "GRAPHIFY_QUERY_LOG_DISABLE": "1",
        // Make the local `graphify update` rebuild AUTHORITATIVE. `update` (run by
        // post-create and by graphify's own post-commit/post-checkout git hooks)
        // resolves symbol references to their defining file and prunes duplicate /
        // JDK-stdlib stub nodes, so a fresh rebuild often has FEWER (cleaner) nodes
        // than one left behind by the heavier `graphify extract`. Without this flag
        // graphify's node-count guard refuses to overwrite the larger graph — which
        // also fires after any code-deleting refactor — and code changes then stop
        // landing in the graph SILENTLY. Forcing lets the leaner, better-resolved
        // rebuild win; safe because graphify-out/ is gitignored and fully
        // rebuildable. Read by both the CLI and the hooks.
        "GRAPHIFY_FORCE": "1",

        "HEADROOM_UPDATE_CHECK": "off",
        "HEADROOM_WORKSPACE_DIR": "/home/vscode/.headroom",
        // Expose headroom's 4th MCP tool, headroom_read (default "off" — see
        // _READ_ENABLED in headroom/ccr/mcp_server.py). It is the only headroom
        // feature that actually reduces context: it caches a file on first read
        // and returns a ~20-token marker on re-reads of the unchanged file,
        // i.e. it intercepts BEFORE content lands in context. headroom_compress
        // cannot do that — content must already be in context to be passed as a
        // parameter, so compressing costs more than it saves. Works standalone;
        // no proxy and no ML extras needed (compression + retrieval are local —
        // mcp_server.py:365). Upstream still flags it, so treat as experimental.
        "HEADROOM_MCP_READ": "on",
        "RTK_TELEMETRY_DISABLED": "1",
        // Native LSP layer: enable Claude Code's built-in LSP tool (semantic
        // go-to-definition / find-references / diagnostics). Auto-on for recent
        // Claude Code (≥ 2.1.50); setting it explicitly is harmless and covers
        // earlier builds. post-create.sh registers per-language LSP plugins from
        // the official marketplace only when this is "1".
        "ENABLE_LSP_TOOL": "1",
        // Git identity — each developer creates .devcontainer/.env.local
        // (gitignored, see .env.local.example) which post-create.sh sources
        // before running `git config --global`. Left empty here so the vars
        // exist in the container environment; .env.local supplies the values.
        "GIT_USER_NAME": "",
        "GIT_USER_EMAIL": "",
        // Development
        "NODE_ENV": "development",
        // Java
        "JAVA_HOME": "/usr/lib/jvm/temurin-jdk",
        // Maven — stable, version-independent home (symlinked in the Dockerfile to
        // the pinned apache-maven-${MAVEN_VERSION}). Exposing it here makes it
        // visible to ALL processes, including the JetBrains/Gateway backend (which
        // is not a login shell and so never sources /etc/profile.d). IntelliJ
        // auto-detects Maven from MAVEN_HOME — pick it under Settings → Build Tools
        // → Maven → "Maven home path". Fixes the empty "-Dide.compiler.maven.path.to.home=".
        "MAVEN_HOME": "/opt/maven",
        // Claude Code — auto permission mode. Set "true" to have post-create.sh
        // write permissions.defaultMode="auto" into the USER settings file
        // (~/.claude/settings.json) on every container start. This is the only
        // supported way to set auto mode: as of Claude Code v2.1.142, the "auto"
        // value is IGNORED in project .claude/settings.json (a repo cannot grant
        // itself auto mode). Best-effort: requires an eligible account (Claude Code
        // v2.1.83+); an ineligible session silently starts in "default" mode.
        // Note: autoMode.environment (trusted infrastructure) must go in
        // .claude/settings.local.json (gitignored), NOT .claude/settings.json.
        "CLAUDE_DEFAULT_MODE_AUTO": "true",
        // Plugin marketplace seed directory — populated at runtime by a live
        // bind-mount of .devcontainer/.plugin-marketplace (see mounts below).
        // initializeCommand refreshes the host clone on every start, so the
        // seed is always current without a rebuild. No runtime auth needed.
        "CLAUDE_CODE_PLUGIN_SEED_DIR": "/opt/claude-seed",
        // Claude Code authentication — long-lived OAuth token, propagated from the host.
        // Generate once on the host with `claude setup-token`, export it in your shell,
        // then rebuild the container. If unset, falls back to interactive login inside
        // the container (run `claude` — it uses a paste-code flow that works without a
        // localhost callback).
        "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
        // EXPERIMENTAL: These flags enable preview features in Claude Code.
        // They may change semantics or be removed without notice across CLI versions.
        // If Claude Code behaves unexpectedly, try removing these first.
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
        "CLAUDE_CODE_ENABLE_TASKS": "true",
        "CLAUDE_CODE_FORK_SUBAGENT": "1"
    },

    // ==========================================================================
    // Volume Mounts for Caching
    // Named volumes persist across container rebuilds.
    // ${devcontainerId} scopes volumes per devcontainer instance.
    // ==========================================================================
    "mounts": [
        // Java/Maven
        "source=devcontainer-maven-repo-${devcontainerId},target=/home/vscode/.m2/repository,type=volume",
        "source=devcontainer-java-userprefs-${devcontainerId},target=/home/vscode/.java/.userPrefs,type=volume",
        // Node.js/NPM
        "source=devcontainer-npm-cache-${devcontainerId},target=/home/vscode/.npm,type=volume",
        // Python/UV/pip
        "source=devcontainer-uv-cache-${devcontainerId},target=/home/vscode/.cache/uv,type=volume",
        "source=devcontainer-pip-cache-${devcontainerId},target=/home/vscode/.cache/pip,type=volume",

        // Claude Code config and cache (named volumes — NOT bind-mounted to avoid host-path conflicts)
        "source=devcontainer-claude-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
        "source=devcontainer-claude-cache-${devcontainerId},target=/home/vscode/.cache/claude-code,type=volume",

        // headroom workspace/CCR store (only used when INSTALL_HEADROOM=true) —
        // memory DB, reversible-compression originals, savings ledger, logs.
        // Persists across rebuilds (HEADROOM_WORKSPACE_DIR=~/.headroom).
        "source=devcontainer-headroom-${devcontainerId},target=/home/vscode/.headroom,type=volume",
        // NOTE: graphify's output (graphify-out/) lives in-repo (gitignored) — no named volume needed.

        // Plugin marketplace seed — LIVE bind-mount of the host clone that a custom
        // local-init.sh (initializeCommand) can refresh on every start.
        // Bind-mounting (instead of a Dockerfile COPY) means every container
        // START picks up the latest plugin versions — no rebuild required.
        // The host directory is populated on the host with host git credentials,
        // so no credentials enter the container. readonly: the container only reads it.
        "source=${localWorkspaceFolder}/.devcontainer/.plugin-marketplace,target=/opt/claude-seed/marketplaces,type=bind,readonly",

        // JetBrains caches
        "source=devcontainer-jetbrains-remote-${devcontainerId},target=/home/vscode/.cache/JetBrains/RemoteDev,type=volume",
        "source=devcontainer-jetbrains-config-${devcontainerId},target=/home/vscode/.config/JetBrains,type=volume",
        "source=devcontainer-jetbrains-cache-${devcontainerId},target=/home/vscode/.cache/JetBrains,type=volume",
        "source=devcontainer-jetbrains-share-${devcontainerId},target=/home/vscode/.local/share/JetBrains,type=volume"
    ],

    // ==========================================================================
    // Resource Limits & Security
    // ==========================================================================
    "runArgs": [
        "--name", "essentials-project-devcontainer",
        "--cpus=8",
        "--memory=16g",
        "--pids-limit=4096",
        // Docker-in-Docker requires privileged mode.
        // Note: --privileged disables AppArmor, seccomp, and capability restrictions.
        // If you ever remove Docker-in-Docker, replace --privileged with:
        //   "--security-opt", "apparmor=docker-default"
        "--privileged"
    ],

    // ==========================================================================
    // Port Forwarding
    // ==========================================================================
    "forwardPorts": [],
    "otherPortsAttributes": {
        "onAutoForward": "notify"
    },
    "portsAttributes": {
        "3000": { "label": "Node.js App", "onAutoForward": "notify" },
        "5005": { "label": "Java Debug (JDWP)", "onAutoForward": "notify" },
        "5432": { "label": "PostgreSQL", "onAutoForward": "silent" },
        "8000": { "label": "Python App", "onAutoForward": "notify" },
        "8080": { "label": "Spring Boot / Generic", "onAutoForward": "notify" },
        "9229": { "label": "Node.js Debug", "onAutoForward": "silent" },
        "63342": { "label": "JetBrains Server", "onAutoForward": "silent" }
    },

    // ==========================================================================
    // IDE Customizations
    // ==========================================================================
    "customizations": {
        "vscode": {
            "extensions": [
                // Core
                "github.copilot"
                ,"github.copilot-chat"
                ,"ms-azuretools.vscode-docker"
                ,"anthropic.claude-code"
                // Java
                ,"vscjava.vscode-java-pack"
                ,"vscjava.vscode-maven"
                ,"vscjava.vscode-spring-initializr"
                ,"vscjava.vscode-spring-boot-dashboard"
                ,"vscjava.vscode-java-test"
                // Node.js/TypeScript (baseline)
                ,"ms-vscode.vscode-typescript-next"
                ,"dbaeumer.vscode-eslint"
                ,"esbenp.prettier-vscode"
                // Python (baseline)
                ,"ms-python.python"
                ,"ms-python.vscode-pylance"
                ,"charliermarsh.ruff"
            ],
            "settings": {
                // Editor
                "editor.formatOnSave": true,
                "editor.tabCompletion": "on",
                "editor.suggestSelection": "first",
                "editor.codeActionsOnSave": {
                    "source.organizeImports": "explicit"
                },
                // Terminal
                "terminal.integrated.defaultProfile.linux": "bash",
                // Java settings
                "java.configuration.updateBuildConfiguration": "automatic",
                "java.saveActions.organizeImports": true,
                "maven.executable.preferMavenWrapper": false,
                // Python settings
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff"
                },
                // TypeScript settings
                "[typescript]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode"
                },
                "[javascript]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode"
                },
                // Telemetry (disabled)
                "telemetry.telemetryLevel": "off",
                "redhat.telemetry.enabled": false,
                "java.telemetry.enabled": false
            }
        },
        // JetBrains Gateway configuration
        "jetbrains": {
            "gateway": {
                "enabled": true
            },
            "backend": "IntelliJ"
        }
    },

    // ==========================================================================
    // Lifecycle Scripts
    // ==========================================================================
    // Runs on the HOST before every container start. Clones/updates the plugin
    // marketplace repo using the developer's local git credentials — credentials
    // never enter the container. The clone is live bind-mounted to
    // /opt/claude-seed/marketplaces (see mounts), so every START — not just a
    // rebuild — picks up the latest plugin versions.
    // local-init.sh is gitignored (internal): when it's absent the
    // container still starts — it just runs without a pre-seeded marketplace.
    // The mkdir -p is required regardless: the bind mount above fails the
    // container create with "bind source path does not exist" if the
    // directory is missing, so an empty directory is created as a fallback.
    "initializeCommand": "mkdir -p .devcontainer/.plugin-marketplace; if [ -f .devcontainer/scripts/local-init.sh ]; then bash .devcontainer/scripts/local-init.sh; else echo 'ℹ️  .devcontainer/scripts/local-init.sh not present — skipping plugin marketplace seed (container still starts).'; fi",
    "onCreateCommand": "echo '✅ DevContainer created successfully!'",
    "postCreateCommand": "if [ -f /workspace/.devcontainer/scripts/post-create.sh ]; then bash /workspace/.devcontainer/scripts/post-create.sh; else echo '⚠️ post-create.sh not found, skipping...'; fi",
    "postStartCommand": "git config --global --add safe.directory /workspace 2>/dev/null || true",
    "waitFor": "postStartCommand",
    "shutdownAction": "stopContainer"
}
