<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dk.trustworks.essentials</groupId>
        <artifactId>parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>essentials-spring-examples</artifactId>
    <name>essentials-spring-examples</name>
    <packaging>pom</packaging>
    <description>Spring Boot examples showing how the Essentials components are used in an application</description>

    <modules>
        <module>postgresql-cqrs</module>
        <module>postgresql-inbox-outbox</module>
        <module>mongodb-inbox-outbox</module>
    </modules>

    <properties>
        <!-- Versions for libraries only used by the examples and therefore not managed by the Essentials parent POM
             nor by the Spring Boot BOM it imports. -->
        <loki-logback-appender.version>2.1.0</loki-logback-appender.version>
        <snappy-java.version>1.1.10.8</snappy-java.version>
    </properties>

    <dependencies>
        <!-- Tracing, latency and metric setup is inspired by
             https://spring.io/blog/2022/10/12/observability-with-spring-boot-3 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>
        <!-- For Observation AOP. Spring Boot 4 dropped spring-boot-starter-aop in favour of
             spring-boot-starter-aspectj. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>
        <!--
          Metrics and tracing exported over OTLP instead of Zipkin. Spring Boot 4 split the actuator into
          per-concern modules: spring-boot-starter-actuator no longer carries the tracing auto-configuration, so
          the OTLP metric registry, the Micrometer/OpenTelemetry tracing bridge, the OTLP exporter and the
          auto-configuration that reads `management.tracing.*` / `management.otlp.*` all come from this one starter
          rather than from the four hand-picked libraries the Boot 3 version of this example listed.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-observation</artifactId>
        </dependency>

        <!-- For pushing logs to Loki -->
        <dependency>
            <groupId>com.github.loki4j</groupId>
            <artifactId>loki-logback-appender</artifactId>
            <version>${loki-logback-appender.version}</version>
            <scope>runtime</scope>
            <exclusions>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-classic</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Kafka message compression -->
        <dependency>
            <groupId>org.xerial.snappy</groupId>
            <artifactId>snappy-java</artifactId>
            <version>${snappy-java.version}</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <!--
                      Bind `repackage` so `mvn package` produces a runnable fat JAR with the Spring Boot
                      launcher manifest. The examples inherit from the Essentials parent POM rather than
                      spring-boot-starter-parent, so this binding isn't picked up implicitly.
                    -->
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <!--
                      Failsafe defaults to putting the *packaged artifact* on the test classpath instead of
                      target/classes. Because `repackage` (above) rewrites that artifact into a Spring Boot
                      fat JAR, the application classes end up under BOOT-INF/classes/ and are invisible to a
                      plain classloader — so @SpringBootTest fails with "Unable to find a
                      @SpringBootConfiguration by searching packages upwards from the test". Point failsafe
                      back at the exploded classes directory.
                    -->
                    <configuration>
                        <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
