{
  "uid": "trading-shard-owned-queues",
  "title": "Shard-owned queues",
  "description": "The shard-owned queue engine: what each queue holds, whether it is being served, and how fast it delivers. Depth, blocked keys, ownership and instances are read from the database and are the same whichever instance reports them, so they are aggregated with max by queue; rates and latencies are per instance and summed.",
  "tags": [
    "essentials",
    "trading-demo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "queue",
        "label": "Queue",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(essentials_queue_depth, queue)",
          "refId": "queue"
        },
        "definition": "label_values(essentials_queue_depth, queue)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(essentials_queue_enqueued_total, instance)",
          "refId": "instance"
        },
        "definition": "label_values(essentials_queue_enqueued_total, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
