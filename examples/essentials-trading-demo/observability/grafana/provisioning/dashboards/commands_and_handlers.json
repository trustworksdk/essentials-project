      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, message_handler_class, message_handler_method) (rate(essentials_messaging_message_handler_milliseconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{message_handler_class}}.{{message_handler_method}}"
