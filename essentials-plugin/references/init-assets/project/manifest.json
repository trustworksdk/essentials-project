    },
    {
      "src": "backend/src/main/kotlin/__PACKAGE__/config/DocumentDbConfig.kt.template",
      "dst": "backend/src/main/kotlin/__PACKAGE__/config/DocumentDbConfig.kt",
      "when": {
        "language": "kotlin",
        "db": [
          "pg-event-sourced",
          "pg-crud"
