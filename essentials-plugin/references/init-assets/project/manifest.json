      "dst": "backend/src/main/kotlin/__PACKAGE__/Application.kt",
      "when": {
        "language": "kotlin"
      }
    },
    {
      "src": "backend/src/main/kotlin/__PACKAGE__/config/EssentialsWebConfig.kt.template",
      "dst": "backend/src/main/kotlin/__PACKAGE__/config/EssentialsWebConfig.kt",
      "when": {
