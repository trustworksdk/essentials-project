  ],
  "generatedPaths": [
    "mvnw",
    "mvnw.cmd",
    ".mvn/wrapper/maven-wrapper.properties",
    "frontend/package-lock.json",
    "frontend/src/shared/api/generated",
    "frontend/src/shared/api/model"
  ],
  "hooks": [
    {
      "id": "maven-wrapper",
      "cwd": ".",
      "run": "mvn -N -B -q org.apache.maven.plugins:maven-wrapper-plugin:{{pin:maven-wrapper-plugin}}:wrapper -Dmaven={{pin:Maven}} -Dtype=only-script",
      "why": "Writes mvnw, mvnw.cmd and .mvn/wrapper/maven-wrapper.properties pinned to the stack pins. Needs a local mvn; without one the project builds with mvn once installed, and dev.sh falls back to it."
    },
    {
      "id": "frontend-lockfile",
      "cwd": "frontend",
      "when": {
        "frontend": [
          "embedded",
          "standalone"
        ]
      },
      "run": "npm install --package-lock-only --no-audit --no-fund",
      "why": "Creates package-lock.json, which the embedded build's `npm ci` requires. Needs npm and the registry; a lockfile cannot be rendered."
    }
  ]
}
