{
  "files": [
    {
      "src": "pom.xml.template",
      "dst": "pom.xml"
    },
    {
      "src": "gitignore.template",
      "dst": ".gitignore"
    },
    {
      "src": "CLAUDE.md.template",
      "dst": "CLAUDE.md"
    },
    {
      "src": "README.md.template",
      "dst": "README.md"
    },
    {
      "src": "dev.sh.template",
      "dst": "dev.sh",
      "mode": "755"
    },
    {
      "src": "contracts/openapi.json.template",
      "dst": "contracts/openapi.json"
    },
    {
      "copy": "references/slice/project-rules-pointer.md.template",
      "dst": ".claude/rules/essentials-slices.md"
    },
    {
      "copy": "scripts/slice-lint.py",
      "dst": "scripts/slice-lint.py",
      "when": {
        "lintGate": [
          "hook",
          "script"
        ]
      },
      "mode": "755"
    },
    {
      "copy": "references/slice/slice-yaml.schema.json",
      "dst": "scripts/slice-yaml.schema.json",
      "when": {
        "lintGate": [
          "hook",
          "script"
        ]
      }
    },
    {
      "src": ".githooks/pre-commit.template",
      "dst": ".githooks/pre-commit",
      "when": {
        "lintGate": "hook"
      },
      "mode": "755"
    },
    {
      "src": "WORKSPACE-CLAUDE.md.template",
      "dst": "CLAUDE.md",
      "root": "workspace"
    },
    {
      "src": "backend/pom.xml.template",
      "dst": "backend/pom.xml"
    },
    {
      "src": "backend/compose.yml.template",
