<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>{{groupId}}</groupId>
        <artifactId>{{artifactId}}-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>{{artifactId}}</artifactId>
    <name>{{projectName}} backend</name>

<!-- IF frontend=embedded -->
    <properties>
        <!-- Set by the skip-frontend profile (S11): backend-only work does not install Node or build the SPA. -->
        <skipFrontend>false</skipFrontend>
    </properties>

<!-- END frontend -->
    <dependencies>
        <!-- ===== Web, security, operations ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
<!-- IF web=webflux -->
            <artifactId>spring-boot-starter-webflux</artifactId>
<!-- END web -->
<!-- IF web=webmvc -->
            <artifactId>spring-boot-starter-webmvc</artifactId>
<!-- END web -->
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <!-- Serves /v3/api-docs; OpenApiContractIT writes it to contracts/openapi.json on `verify` (S7) -->
            <groupId>org.springdoc</groupId>
<!-- IF web=webflux -->
            <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
<!-- END web -->
<!-- IF web=webmvc -->
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
<!-- END web -->
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ===== Trustworks Essentials (S2): exactly one persistence starter ===== -->
        <dependency>
            <groupId>dk.trustworks.essentials.components</groupId>
<!-- IF db=pg-event-sourced -->
            <artifactId>spring-boot-starter-postgresql-event-store</artifactId>
<!-- END db -->
<!-- IF db=pg-crud -->
            <artifactId>spring-boot-starter-postgresql</artifactId>
<!-- END db -->
<!-- IF db=mongo -->
            <artifactId>spring-boot-starter-mongodb</artifactId>
<!-- END db -->
            <version>${essentials.version}</version>
        </dependency>
<!-- IF db=pg-event-sourced -->
        <dependency>
            <!-- Optional in the event-store starter, so not transitive: the decider and aggregate APIs live here -->
            <groupId>dk.trustworks.essentials.components</groupId>
            <artifactId>eventsourced-aggregates</artifactId>
            <version>${essentials.version}</version>
        </dependency>
<!-- IF language=kotlin -->
        <dependency>
            <!-- The Kotlin Decider/Evolver DSL. Kotlin only: Java uses EventStreamDecider from eventsourced-aggregates -->
            <groupId>dk.trustworks.essentials.components</groupId>
            <artifactId>kotlin-eventsourcing</artifactId>
            <version>${essentials.version}</version>
        </dependency>
<!-- END language -->
<!-- END db -->
<!-- IF db!=mongo -->
        <dependency>
            <!-- The read-model store on PostgreSQL (S5); config/DocumentDbConfig builds its factory -->
            <groupId>dk.trustworks.essentials.components</groupId>
            <artifactId>postgresql-document-db</artifactId>
            <version>${essentials.version}</version>
        </dependency>
<!-- END db -->
        <dependency>
            <!-- Inert until config/EssentialsWebConfig @Imports its configurer (S4) -->
            <groupId>dk.trustworks.essentials</groupId>
            <artifactId>types-spring-web</artifactId>
            <version>${essentials.version}</version>
        </dependency>

        <!-- ===== S2.1: what the starter does not bring. Every one is `provided` upstream, so none is
             transitive, and most compile without complaint: they fail at context startup. They look
             unused; do not remove them. ===== -->
<!-- IF db!=mongo -->
        <dependency>
            <!-- {{why:S2.1:spring-boot-starter-jdbc}} -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <!-- {{why:S2.1:org.postgresql:postgresql}} -->
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <!-- {{why:S2.1:jdbi3-core}} -->
            <groupId>org.jdbi</groupId>
            <artifactId>jdbi3-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jdbi</groupId>
            <artifactId>jdbi3-postgres</artifactId>
        </dependency>
        <dependency>
            <!-- {{why:S2.1:kotlin-stdlib-jdk8}} -->
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib-jdk8</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-reflect</artifactId>
        </dependency>
<!-- END db -->
<!-- IF db=mongo -->
        <dependency>
            <!-- {{why:S2.1:spring-boot-starter-data-mongodb}} -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>
<!-- END db -->
        <dependency>
            <!-- {{why:S2.1:tools.jackson.core:jackson-databind}} -->
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
<!-- IF web=webmvc -->
        <dependency>
            <!-- {{why:S2.1:reactor-core}} -->
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>
<!-- END web -->
<!-- IF language=kotlin -->

        <!-- ===== Kotlin ===== -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>
<!-- IF db=mongo -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-reflect</artifactId>
        </dependency>
<!-- END db -->
        <dependency>
            <!-- KotlinModule: reaches the web mapper by itself, the persistence mapper only through
                 config/PersistenceSerializerConfiguration (S3.4) -->
            <groupId>tools.jackson.module</groupId>
            <artifactId>jackson-module-kotlin</artifactId>
        </dependency>
<!-- IF web=webflux -->
        <dependency>
            <groupId>io.projectreactor.kotlin</groupId>
            <artifactId>reactor-kotlin-extensions</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-reactor</artifactId>
        </dependency>
<!-- END web -->
<!-- END language -->
<!-- IF compose -->

        <!-- ===== Development: starts backend/compose.yml on spring-boot:run ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
<!-- END compose -->

        <!-- ===== Test (S10) ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
<!-- IF web=webflux -->
            <artifactId>spring-boot-starter-webflux-test</artifactId>
<!-- END web -->
<!-- IF web=webmvc -->
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
<!-- END web -->
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- @ServiceConnection: the test container becomes the application's database -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Testcontainers 2.x artifact names; the 1.x coordinates no longer resolve (S10) -->
            <groupId>org.testcontainers</groupId>
<!-- IF db!=mongo -->
            <artifactId>testcontainers-postgresql</artifactId>
<!-- END db -->
<!-- IF db=mongo -->
            <artifactId>testcontainers-mongodb</artifactId>
<!-- END db -->
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
<!-- IF language=kotlin -->
            <artifactId>awaitility-kotlin</artifactId>
<!-- END language -->
<!-- IF language=java -->
            <artifactId>awaitility</artifactId>
<!-- END language -->
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${jqwik.version}</version>
            <scope>test</scope>
        </dependency>
<!-- IF language=kotlin -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik-kotlin</artifactId>
            <version>${jqwik.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>
<!-- END language -->
    </dependencies>

    <build>
<!-- IF language=kotlin -->
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
<!-- END language -->
        <plugins>
<!-- IF language=kotlin -->
            <plugin>
                <!-- The all-open `spring` plugin lets Spring proxy final Kotlin classes; both arguments are
                     load-bearing (see the essentials plugin's kotlin-spring-boot.md) -->
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <configuration>
                    <args>
                        <arg>-Xjsr305=strict</arg>
                        <arg>-Xannotation-default-target=param-property</arg>
                    </args>
                    <compilerPlugins>
                        <plugin>spring</plugin>
                    </compilerPlugins>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-allopen</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
<!-- END language -->
            <plugin>
                <!-- -parameters is mandatory, not hygiene: constructor parameter names are part of the JSON
                     contract under Jackson 3, and without it they erase to arg0, arg1 (S3.5) -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <!-- Unit tests only; *IT and *IntegrationTest belong to Failsafe (S10) -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                        <exclude>**/*IntegrationTest.java</exclude>
                    </excludes>
                    <argLine>-XX:TieredStopAtLevel=1 -Dspring.jmx.enabled=false</argLine>
                </configuration>
            </plugin>
            <plugin>
                <!-- Integration tests on `verify`, one reused fork and a small context cache: a second Spring
                     context shows up as an eviction instead of a silently slower suite. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                        <include>**/*IntegrationTest.java</include>
                    </includes>
                    <reuseForks>true</reuseForks>
                    <argLine>-XX:TieredStopAtLevel=1 -Dspring.jmx.enabled=false -Dspring.test.context.cache.maxSize=4</argLine>
                    <systemPropertyVariables>
                        <!-- Where OpenApiContractIT writes the regenerated API contract (S7) -->
                        <contracts.dir>${project.basedir}/../contracts</contracts.dir>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
<!-- IF frontend=embedded -->
            <plugin>
                <!-- Embedded frontend (S8, Mode A): Node install, npm ci, orval, build, all on prepare-package
                     and in that order. Orval reads the committed contracts/openapi.json. -->
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <configuration>
                    <workingDirectory>${project.basedir}/../frontend</workingDirectory>
                    <installDirectory>${project.basedir}/../frontend</installDirectory>
                    <skip>${skipFrontend}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-ci</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>orval-generate</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>npx</goal>
                        </goals>
                        <configuration>
                            <arguments>orval</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Copies the built SPA into the JAR's static resources -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-frontend-dist</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <skip>${skipFrontend}</skip>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../frontend/dist</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
<!-- END frontend -->
        </plugins>
    </build>
<!-- IF frontend=embedded -->

    <profiles>
        <profile>
            <!-- S11: `-Pskip-frontend` for backend-only work, so spring-boot:run and verify do not run npm -->
            <id>skip-frontend</id>
            <properties>
                <skipFrontend>true</skipFrontend>
            </properties>
        </profile>
    </profiles>
<!-- END frontend -->
</project>
