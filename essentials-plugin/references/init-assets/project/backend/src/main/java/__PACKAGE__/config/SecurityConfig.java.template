package {{packagePath}}.config;

import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
<!-- IF frontend=standalone -->
import org.springframework.security.config.Customizer;
<!-- END frontend -->
<!-- IF web=webflux -->
import org.springframework.security.config.annotation.web.reactive.EnableWebFluxSecurity;
import org.springframework.security.config.web.server.ServerHttpSecurity;
import org.springframework.security.web.server.SecurityWebFilterChain;
<!-- END web -->
<!-- IF web=webmvc -->
import org.springframework.security.config.annotation.web.builders.HttpSecurity;
import org.springframework.security.config.annotation.web.configuration.EnableWebSecurity;
import org.springframework.security.config.annotation.web.configurers.AbstractHttpConfigurer;
import org.springframework.security.web.SecurityFilterChain;
<!-- END web -->

/**
 * S9: a permit-all STARTING POINT, not a security posture. Replace it before the application leaves a laptop.
 * CSRF is off because nothing here authenticates yet; decide it again together with authentication.
 */
@Configuration
<!-- IF web=webflux -->
@EnableWebFluxSecurity
<!-- END web -->
<!-- IF web=webmvc -->
@EnableWebSecurity
<!-- END web -->
public class SecurityConfig {
    @Bean
<!-- IF web=webflux -->
    public SecurityWebFilterChain securityWebFilterChain(ServerHttpSecurity http) {
        return http
                .csrf(ServerHttpSecurity.CsrfSpec::disable)
<!-- IF frontend=standalone -->
                .cors(Customizer.withDefaults())   // applies the CorsConfigurationSource bean inside the security chain (S8, Mode B)
<!-- END frontend -->
                .authorizeExchange(exchanges -> exchanges.anyExchange().permitAll())
                .build();
    }
<!-- END web -->
<!-- IF web=webmvc -->
    public SecurityFilterChain securityFilterChain(HttpSecurity http) throws Exception {
        return http
                .csrf(AbstractHttpConfigurer::disable)
<!-- IF frontend=standalone -->
                .cors(Customizer.withDefaults())   // applies the CorsConfigurationSource bean inside the security chain (S8, Mode B)
<!-- END frontend -->
                .authorizeHttpRequests(requests -> requests.anyRequest().permitAll())
                .build();
    }
<!-- END web -->
}
