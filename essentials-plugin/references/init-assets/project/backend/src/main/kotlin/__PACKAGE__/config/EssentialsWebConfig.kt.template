package {{packagePath}}.config

<!-- IF web=webflux -->
import dk.trustworks.essentials.types.spring.web.EssentialsWebFluxConfigurer
<!-- END web -->
<!-- IF web=webmvc -->
import dk.trustworks.essentials.types.spring.web.EssentialsWebMvcConfigurer
<!-- END web -->
import dk.trustworks.essentials.types.spring.web.SingleValueTypeModelConverter
import org.springframework.context.annotation.Bean
import org.springframework.context.annotation.Configuration
import org.springframework.context.annotation.Import

/**
 * S4: types-spring-web auto-configures nothing. This `@Import` is the registration of the converter that binds
 * Essentials semantic types as path variables and request parameters; without it they fail with HTTP 500.
 * Import exactly one configurer, matching the web stack.
 */
@Configuration
<!-- IF web=webflux -->
@Import(EssentialsWebFluxConfigurer::class)
<!-- END web -->
<!-- IF web=webmvc -->
@Import(EssentialsWebMvcConfigurer::class)
<!-- END web -->
class EssentialsWebConfig {

    /**
     * S7: makes springdoc describe semantic types as the JSON they are written as — a value-class id as a string
     * under its real property name, not as an object under its mangled JVM name — so the client generated from
     * contracts/openapi.json types every id correctly. Not auto-configured either.
     */
    @Bean
    fun singleValueTypeModelConverter() = SingleValueTypeModelConverter()
}
