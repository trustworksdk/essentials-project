#!/usr/bin/env bash
# Slice manifest gate: see the essentials plugin, /essentials:slice-check.
# Self-locating: it lints the project it sits in (the directory above .githooks/), which need not
# be the repository's top level, and only when a slice.yaml inside that project is staged.
# Not active until each clone runs the activation command in the project README.
# Blocks the commit when the linter cannot run (exit 2: install uv, or pyyaml and jsonschema), and
# when its own script is missing. It lets the commit through only when neither uv nor python3 exists.
proj="$(cd "$(dirname "$0")/.." && pwd)" || exit 1
cd "$proj" || exit 1
git diff --cached --name-only --relative --diff-filter=ACM -- . | grep -q 'slice\.yaml$' || exit 0
if [ ! -f scripts/slice-lint.py ] || [ ! -f scripts/slice-yaml.schema.json ]; then
    echo "slice-lint: scripts/slice-lint.py or scripts/slice-yaml.schema.json is missing in $proj." >&2
    echo "  Restore them (/essentials:upgrade reinstalls both), or remove .githooks/pre-commit." >&2
    exit 1
fi
if command -v uv >/dev/null 2>&1; then
    uv run --script scripts/slice-lint.py . --schema scripts/slice-yaml.schema.json
elif command -v python3 >/dev/null 2>&1; then
    python3 scripts/slice-lint.py . --schema scripts/slice-yaml.schema.json
else
    echo "slice-lint: neither uv nor python3 is installed; slice.yaml not checked, not blocking." >&2
    exit 0
fi
status=$?
[ $status -eq 2 ] && echo "slice-lint could not validate the manifests (install uv, or: pip install pyyaml jsonschema). To commit anyway: git commit --no-verify" >&2
exit $status
