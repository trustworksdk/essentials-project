+package com.acme.shop.config
+
+import com.fasterxml.jackson.databind.ObjectMapper
+
+@Configuration
+class WiringConfig {
+    @Bean fun eventMapper() = ObjectMapper()
+    @Bean fun webMapper() = JsonMapper.builder().build()
+    @Bean fun serializer() = EssentialsObjectMappers.createJSONSerializer()
+    @Bean fun commandBus() = LocalCommandBus()
+    @Bean fun durableBus(queues: DurableQueues) = DurableLocalCommandBus.builder().setDurableQueues(queues).build()
+    @Bean fun jdbi(ds: DataSource) = Jdbi.create(ds)
+    @Bean fun txJdbi(ds: DataSource) = Jdbi.create(TransactionAwareDataSourceProxy(ds))
+    override fun addFormatters(registry: FormatterRegistry) {
+        registry.addConverter(KotlinValueTypeConverter())
+        // registry.addConverter(KotlinValueTypeConverter())
+    }
+}
