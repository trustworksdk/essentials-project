+++ b/backend/src/main/java/com/example/shop/ShopQueues.java
@@ -0,0 +1,17 @@
+package com.example.shop;
+
+class ShopQueues {
+    DurableQueues queues(PostgresqlDurableQueues existing) {
+        var flag = existing.isUseOrderedUnorderedQuery();
+        return PostgresqlDurableQueues.builder()
+                                      .setSharedQueueTableName("queues")
+                                      .setUseOrderedUnorderedQuery(true)
+                                      .build();
+    }
+
+    void configure(PostgresqlDurableQueuesBuilder builder, boolean flag) {
+        builder.setUseOrderedUnorderedQuery(flag);
+        builder.setUseCentralizedMessageFetcher(true);
+    }
+    boolean isUseOrderedUnorderedQuery() { return true; }
+}
