+package {{packagePath}}.orders.views.expedited_orders
+
+import {{packagePath}}.orders.types.OrderId
+import org.springframework.web.bind.annotation.GetMapping
+import org.springframework.web.bind.annotation.PathVariable
+import org.springframework.web.bind.annotation.RequestMapping
+import org.springframework.web.bind.annotation.RestController
+
+/** Read API for THIS view slice only; both queries read its own read model. */
+@RestController
+@RequestMapping("/api/orders/expedited")
+class ExpeditedOrdersAPI(private val repository: ExpeditedOrdersRepository) {
+
+    @GetMapping
+    fun list(): List<ExpeditedOrderRow> = repository.findAll().sortedBy { it.orderId.value }
