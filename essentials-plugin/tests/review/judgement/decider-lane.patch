@@ -0,0 +1,24 @@
+package {{packagePath}}.orders.use_cases.expedite_order
+
+import {{packagePath}}.orders.events.OrderEvent
+import {{packagePath}}.orders.events.OrderExpedited
+import {{packagePath}}.orders.types.OrderStatus
+import {{packagePath}}.orders.use_cases.cancel_order.OrderState
+import {{packagePath}}.orders.use_cases.cancel_order.OrderStateEvolver
+import dk.trustworks.essentials.components.kotlin.eventsourcing.Decider
+import dk.trustworks.essentials.components.kotlin.eventsourcing.Evolver
+
+/** Expedites a placed order: it jumps the warehouse queue. Only a PLACED order can be expedited. */
+class ExpediteOrderDecider : Decider<ExpediteOrder, OrderEvent> {
+    private val evolver = OrderStateEvolver()
+
+    override fun handle(cmd: ExpediteOrder, events: List<OrderEvent>): OrderEvent? {
+        val state: OrderState? = Evolver.applyEvents(evolver, null, events)
+        requireNotNull(state) { "Order does not exist" }
+        if (events.any { it is OrderExpedited }) return null           // idempotent
+        require(state.status == OrderStatus.PLACED) { "Cannot expedite order in ${state.status}" }
+        return OrderExpedited(cmd.id, cmd.reason)
+    }
+
+    override fun canHandle(cmd: Any): Boolean = cmd is ExpediteOrder
+}
