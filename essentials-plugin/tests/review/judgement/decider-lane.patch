+package {{packagePath}}.orders.external_systems.warehouse
+
+import tools.jackson.module.kotlin.jacksonObjectMapper
+import org.springframework.beans.factory.annotation.Value
+import org.springframework.stereotype.Component
+import java.net.URI
+import java.net.http.HttpClient
+import java.net.http.HttpRequest
+import java.net.http.HttpResponse
+
+/**
+ * HTTP transport for [WarehouseClient]. The body is the warehouse's own JSON contract
+ * ([WarehouseReservationRequest]), written with a plain mapper; nothing here is stored.
+ */
+@Component
+class WarehouseHttpClient(
+    @Value("\${warehouse.base-url}") private val baseUrl: String
+) : WarehouseClient {
+
+    private val http = HttpClient.newHttpClient()
+    private val json = jacksonObjectMapper()
+
+    override fun reserve(request: WarehouseReservationRequest) {
+        val call = HttpRequest.newBuilder(URI.create("$baseUrl/reservations"))
+            .header("Content-Type", "application/json")
+            .POST(HttpRequest.BodyPublishers.ofString(json.writeValueAsString(request)))
+            .build()
+        val response = http.send(call, HttpResponse.BodyHandlers.discarding())
+        check(response.statusCode() in 200..299) { "warehouse answered ${response.statusCode()}" }
+    }
+}
