import { BrowserRouter, Route, Routes } from 'react-router-dom'

const queryClient = new QueryClient()

// The app shell. One component per use-case lives under src/domains/<bc>/; pages here stay thin and compose them.
export function App() {
  return (
    <QueryClientProvider client={queryClient}>
      <BrowserRouter>
        <Routes>
          <Route path="*" element={<Home />} />
        </Routes>
      </BrowserRouter>
    </QueryClientProvider>
  )
}

