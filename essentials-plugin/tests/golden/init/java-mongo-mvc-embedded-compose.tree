package com.example.golden.config;

import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.security.config.annotation.web.builders.HttpSecurity;
import org.springframework.security.config.annotation.web.configuration.EnableWebSecurity;
import org.springframework.security.config.annotation.web.configurers.AbstractHttpConfigurer;
import org.springframework.security.web.SecurityFilterChain;

/**
 * S9: a permit-all STARTING POINT, not a security posture. Replace it before the application leaves a laptop.
 * CSRF is off because nothing here authenticates yet; decide it again together with authentication.
 */
@Configuration
@EnableWebSecurity
public class SecurityConfig {
    @Bean
    public SecurityFilterChain securityFilterChain(HttpSecurity http) throws Exception {
        return http
                .csrf(AbstractHttpConfigurer::disable)
                .authorizeHttpRequests(requests -> requests.anyRequest().permitAll())
                .build();
    }
}
=== FILE backend/src/main/java/com/example/golden/config/SpaWebFilter.java (644) ===
package com.example.golden.config;

import jakarta.servlet.FilterChain;
import jakarta.servlet.ServletException;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import org.springframework.stereotype.Component;
import org.springframework.web.filter.OncePerRequestFilter;

import java.io.IOException;
import java.util.List;
import java.util.regex.Pattern;

/**
 * Embedded frontend (S8, Mode A): deep links such as /orders/42 reach index.html so the client-side router can
 * handle them. API and infrastructure prefixes, and any path ending in a file extension, pass through.
 */
@Component
public class SpaWebFilter extends OncePerRequestFilter {
    private static final List<String> API_PREFIXES      = List.of("/api/", "/v3/", "/swagger-ui", "/actuator");
    private static final Pattern      EXTENSION_PATTERN = Pattern.compile("\\.[a-zA-Z0-9]+$");

    private static boolean passesThrough(String path) {
        if (API_PREFIXES.stream().anyMatch(path::startsWith)) {
            return true;
        }
        return EXTENSION_PATTERN.matcher(path.substring(path.lastIndexOf('/') + 1)).find();
    }

    @Override
    protected void doFilterInternal(HttpServletRequest request, HttpServletResponse response, FilterChain chain)
            throws ServletException, IOException {
        if (passesThrough(request.getRequestURI().substring(request.getContextPath().length()))) {
            chain.doFilter(request, response);
            return;
        }
        request.getRequestDispatcher("/index.html").forward(request, response);
    }
}
