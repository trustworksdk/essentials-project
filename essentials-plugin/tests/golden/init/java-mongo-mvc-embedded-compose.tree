=== FILE frontend/src/shared/api/custom-fetch.test.ts (644) ===
import { afterEach, describe, expect, it, vi } from 'vitest'
import { customFetch } from './custom-fetch'

const stubFetch = (response: () => Response) => {
  const fetchMock = vi.fn<typeof fetch>(async () => response())
  vi.stubGlobal('fetch', fetchMock)
  return fetchMock
}

const requestedUrl = (fetchMock: ReturnType<typeof stubFetch>) => fetchMock.mock.calls[0][0]

describe('customFetch', () => {
  afterEach(() => {
    vi.unstubAllEnvs()
    vi.unstubAllGlobals()
  })

  it('keeps requests relative: the SPA and the API share an origin, so no base URL is read', async () => {
    vi.stubEnv('VITE_API_BASE_URL', 'https://api.example')
    const fetchMock = stubFetch(() => new Response('{}'))

    await customFetch('/api/x')

    expect(requestedUrl(fetchMock)).toBe('/api/x')
  })

  it('returns data, status and headers, and tolerates the empty body of a void endpoint', async () => {
    stubFetch(() => new Response(null, { status: 204 }))

    const result = await customFetch<{ data: unknown; status: number }>('/api/x', { method: 'POST' })

    expect(result.status).toBe(204)
    expect(result.data).toBeUndefined()
  })
})
=== FILE frontend/src/shared/api/custom-fetch.ts (644) ===
// The one file you own in the generated-client chain (S8): auth headers, error shape and the base URL live here.
export const customFetch = async <T>(url: string, options: RequestInit = {}): Promise<T> => {
  // Embedded (Mode A): the SPA and the API share an origin, so requests stay relative. Do not add a base URL here.
  const baseUrl = ''
  const headers = new Headers(options.headers)
  if (!headers.has('Accept')) headers.set('Accept', 'application/json')

  const response = await fetch(`${baseUrl}${url}`, { ...options, headers })

  // Void endpoints answer 200/204 with no body; response.json() throws on that and would break every void mutation.
  const text = await response.text()
  const data: unknown = text ? JSON.parse(text) : undefined

  return { data, status: response.status, headers: response.headers } as T
}
