package com.example.golden;

import org.junit.jupiter.api.Test;

import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;

import static org.assertj.core.api.Assertions.assertThat;

/**
 * The wiring test: the whole context starts against a real MongoDB and reports healthy. Every S2.1 dependency,
 * the serializers and the web configurer are bean-wiring concerns that compile cleanly and fail only here.
 */
class ApplicationContextIT extends IntegrationTestBase {

    @Test
    void context_starts_and_reports_healthy() throws Exception {
        try (var client = HttpClient.newHttpClient()) {
            var response = client.send(HttpRequest.newBuilder(URI.create(baseUrl() + "/actuator/health")).build(),
                                       HttpResponse.BodyHandlers.ofString());

            assertThat(response.statusCode()).isEqualTo(200);
            assertThat(response.body()).contains("\"status\":\"UP\"");
        }
    }
}
=== FILE backend/src/test/java/com/example/golden/IntegrationTestBase.java (644) ===
package com.example.golden;

import org.bson.Document;
import org.junit.jupiter.api.BeforeEach;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.boot.test.web.server.LocalServerPort;
import org.springframework.boot.testcontainers.service.connection.ServiceConnection;
import org.springframework.data.mongodb.core.MongoTemplate;
import org.testcontainers.mongodb.MongoDBContainer;

import java.util.List;

/**
 * The base for this project's integration tests: one database container per test JVM, shared by every test class,
 * and one cached Spring context. The recipe and what keeps it safe with Essentials (never truncate an *_events table,
 * rebuild read models through their subscriptions) are in the essentials-docs skill: LLM-foundation-test.md,
 * "Fast integration tests".
 * <p>
 * Container reuse across builds is opt-in: {@code -Dit.containers.reuse=true} with a single Failsafe fork, plus
 * {@code testcontainers.reuse.enable=true} in {@code ~/.testcontainers.properties}.
 */
@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
public abstract class IntegrationTestBase {

    @ServiceConnection
    static final MongoDBContainer mongo = new MongoDBContainer("mongo:8.2")
            .withReplicaSet()   // Essentials' Mongo transactions need a replica set; this container is standalone without it
            .withReuse(Boolean.getBoolean("it.containers.reuse"));

    static {
        mongo.start();
    }

    @LocalServerPort
    protected int port;

    @Autowired
    protected MongoTemplate mongoTemplate;

    /** Read-model collections only; never the collections Essentials' queues and locks keep their state in. */
    protected List<String> readModelCollectionsToClear() {
        return List.of();
    }

    @BeforeEach
    void clearReadModels() {
        readModelCollectionsToClear().forEach(collection -> mongoTemplate.getCollection(collection).deleteMany(new Document()));
    }

    protected String baseUrl() {
        return "http://localhost:" + port;
    }
}
=== FILE backend/src/test/java/com/example/golden/OpenApiContractIT.java (644) ===
package com.example.golden;

import org.junit.jupiter.api.Test;
import tools.jackson.databind.SerializationFeature;
import tools.jackson.databind.json.JsonMapper;
import tools.jackson.databind.node.ObjectNode;

import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.nio.file.Files;
import java.nio.file.Path;

import static org.assertj.core.api.Assertions.assertThat;

/**
 * S7: regenerates contracts/openapi.json from the running application on every `mvn verify`. The contract is
 * generated from the code, never hand-written; commit the regenerated file together with the endpoint change.
 * <p>
 * It runs against the integration-test context and its database, because the beans an endpoint needs are
 * the ones that reach the database as they are created.
 */
class OpenApiContractIT extends IntegrationTestBase {

    @Test
    void writes_the_openapi_contract() throws Exception {
        String body;
        try (var client = HttpClient.newHttpClient()) {
            var response = client.send(HttpRequest.newBuilder(URI.create(baseUrl() + "/v3/api-docs")).build(),
                                       HttpResponse.BodyHandlers.ofString());
            assertThat(response.statusCode()).as("GET /v3/api-docs").isEqualTo(200);
            body = response.body();
        }

        var mapper = JsonMapper.builder().enable(SerializationFeature.INDENT_OUTPUT).build();
        var contract = (ObjectNode) mapper.readTree(body);
        contract.remove("servers");   // the random test port is not part of the contract

        var target = Path.of(System.getProperty("contracts.dir", "../contracts"), "openapi.json");
        Files.createDirectories(target.getParent());
        Files.writeString(target, mapper.writeValueAsString(contract) + "\n");
    }
}
