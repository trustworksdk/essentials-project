=== FILE dev.sh (755) ===
#!/usr/bin/env bash
# =============================================================================
# dev.sh: development convenience script
#
# Usage:
#   ./dev.sh backend      Start Spring Boot on :8080 (expects PostgreSQL to be running; see application.yml)
# =============================================================================
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# The Maven wrapper when the project has one, otherwise the Maven on the PATH.
if [ -x ./mvnw ]; then MVN=./mvnw; else MVN=mvn; fi

cmd_backend() {
    echo "Starting the Spring Boot backend on :8080..."
    "$MVN" -pl backend spring-boot:run
}

case "${1:-backend}" in
    backend)   cmd_backend ;;
    *)
        echo "Usage: $0 {backend}"
        exit 1
        ;;
esac
