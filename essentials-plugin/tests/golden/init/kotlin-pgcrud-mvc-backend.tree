<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The reactor parent: owns every version property and BOM import (S11). Versions come from the
         essentials plugin's stack pins; moving one is an upgrade decision, not an implementation choice. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>golden-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Golden</name>

    <modules>
        <module>backend</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <!-- Spring Boot manages Kotlin too; this property is what overrides it. Load-bearing on a Java
             project as well: postgresql-document-db is written in Kotlin (S2.1). -->
        <kotlin.version>2.4.10</kotlin.version>
        <!-- One property drives every Essentials artifact (S1). -->
        <essentials.version>0.60.0</essentials.version>
        <springdoc.version>3.1.1</springdoc.version>
        <!-- Spring Boot's parent already manages Testcontainers, Mockito, AssertJ, Awaitility and the MongoDB
             driver. A BOM imported below would be inert for them (the parent's management wins), so their
             versions are set through the properties Spring Boot reads (S11). -->
        <testcontainers.version>2.0.5</testcontainers.version>
        <mockito.version>5.23.0</mockito.version>
        <assertj.version>3.27.7</assertj.version>
        <awaitility.version>4.3.0</awaitility.version>
        <!-- Not managed by Spring Boot: imported as BOMs below. -->
        <jdbi3-bom.version>3.54.0</jdbi3-bom.version>
        <spring-modulith.version>2.0.7</spring-modulith.version>
        <jqwik.version>1.9.3</jqwik.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jdbi</groupId>
                <artifactId>jdbi3-bom</artifactId>
                <version>${jdbi3-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
