package com.example.golden

import org.assertj.core.api.Assertions.assertThat
import org.junit.jupiter.api.Test
import java.net.URI
import java.net.http.HttpClient
import java.net.http.HttpRequest
import java.net.http.HttpResponse

/**
 * The wiring test: the whole context starts against a real PostgreSQL and reports healthy. Every S2.1 dependency,
 * the serializers and the web configurer are bean-wiring concerns that compile cleanly and fail only here.
 */
class ApplicationContextIT : IntegrationTestBase() {

    @Test
    fun `context starts and reports healthy`() {
        HttpClient.newHttpClient().use { client ->
            val response = client.send(
                HttpRequest.newBuilder(URI.create(baseUrl() + "/actuator/health")).build(),
                HttpResponse.BodyHandlers.ofString()
            )

            assertThat(response.statusCode()).isEqualTo(200)
            assertThat(response.body()).contains("\"status\":\"UP\"")
        }
    }
}
=== FILE backend/src/test/kotlin/com/example/golden/IntegrationTestBase.kt (644) ===
package com.example.golden

import org.jdbi.v3.core.Jdbi
import org.junit.jupiter.api.BeforeEach
import org.springframework.beans.factory.annotation.Autowired
import org.springframework.boot.test.context.SpringBootTest
import org.springframework.boot.test.web.server.LocalServerPort
import org.springframework.boot.testcontainers.service.connection.ServiceConnection
import org.testcontainers.postgresql.PostgreSQLContainer

/**
 * The base for this project's integration tests: one database container per test JVM, shared by every test class,
 * and one cached Spring context. The recipe and what keeps it safe with Essentials (never truncate an *_events table,
 * rebuild read models through their subscriptions) are in the essentials-docs skill: LLM-foundation-test.md,
 * "Fast integration tests".
 *
 * Container reuse across builds is opt-in: `-Dit.containers.reuse=true` with a single Failsafe fork, plus
 * `testcontainers.reuse.enable=true` in `~/.testcontainers.properties`.
 */
@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
abstract class IntegrationTestBase {

    @LocalServerPort
    protected var port: Int = 0

    @Autowired
    protected lateinit var jdbi: Jdbi

    /**
     * Read-model tables only. Never an *_events table: truncating one with RESTART IDENTITY rewinds the global order
     * while every subscription keeps its resume point, and the next test hangs instead of failing.
     */
    protected open fun readModelTablesToTruncate(): List<String> = emptyList()

    @BeforeEach
    fun truncateReadModels() {
        val tables = readModelTablesToTruncate()
        if (tables.isNotEmpty()) {
            jdbi.useHandle<RuntimeException> { it.execute("TRUNCATE TABLE " + tables.joinToString(", ")) }
        }
    }

    protected fun baseUrl(): String = "http://localhost:$port"

    companion object {
        @JvmField
        @ServiceConnection
        val postgres: PostgreSQLContainer = PostgreSQLContainer("postgres:18.4")   // not generic in Testcontainers 2
            .withReuse(System.getProperty("it.containers.reuse").toBoolean())
            .withTmpFs(mapOf("/var/lib/postgresql" to "rw"))   // data in RAM; PGDATA sits inside this mount from Postgres 18
            .withCommand("postgres", "-c", "fsync=off", "-c", "synchronous_commit=off", "-c", "full_page_writes=off")
            .also { it.start() }
    }
}
=== FILE backend/src/test/kotlin/com/example/golden/OpenApiContractIT.kt (644) ===
package com.example.golden

import org.assertj.core.api.Assertions.assertThat
import org.junit.jupiter.api.Test
import tools.jackson.databind.SerializationFeature
import tools.jackson.databind.json.JsonMapper
import tools.jackson.databind.node.ObjectNode
import java.net.URI
import java.net.http.HttpClient
import java.net.http.HttpRequest
import java.net.http.HttpResponse
import java.nio.file.Files
import java.nio.file.Path

/**
 * S7: regenerates contracts/openapi.json from the running application on every `mvn verify`. The contract is
 * generated from the code, never hand-written; commit the regenerated file together with the endpoint change.
 *
 * It runs against the integration-test context and its database, because the beans an endpoint needs are
 * the ones that reach the database as they are created.
 */
class OpenApiContractIT : IntegrationTestBase() {

    @Test
    fun `writes the openapi contract`() {
        val body = HttpClient.newHttpClient().use { client ->
            val response = client.send(
                HttpRequest.newBuilder(URI.create(baseUrl() + "/v3/api-docs")).build(),
                HttpResponse.BodyHandlers.ofString()
            )
            assertThat(response.statusCode()).`as`("GET /v3/api-docs").isEqualTo(200)
            response.body()
        }

        val mapper = JsonMapper.builder().enable(SerializationFeature.INDENT_OUTPUT).build()
        val contract = mapper.readTree(body) as ObjectNode
        contract.remove("servers")   // the random test port is not part of the contract

        val target = Path.of(System.getProperty("contracts.dir", "../contracts"), "openapi.json")
        Files.createDirectories(target.parent)
        Files.writeString(target, mapper.writeValueAsString(contract) + "\n")
    }
}
